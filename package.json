    "build:demo": "node demo/build.js",
    "serve:demo": "node demo/serve.js",
    "publish:demo": "node demo/publish.js"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.2"
  }
}
