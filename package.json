{
  "name": "agitae",
  "version": "0.1.0",
  "description": "Agitaê — marketplace brasileiro de serviços para festas e eventos",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
