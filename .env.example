# Copie para .env (o servidor lê este arquivo automaticamente; nada aqui vai para o frontend)
PORT=3000
NODE_ENV=development
DATABASE_FILE=./data/agitae.db
UPLOAD_DIR=./data/uploads
PUBLIC_URL=http://localhost:3000

# Segredo usado para assinar/validar webhooks de pagamento (troque em produção!)
PAYMENT_WEBHOOK_SECRET=troque-este-segredo

# "test" = provedor simulado (só para desenvolvimento/homologação).
# "live" = exige credenciais reais do provedor; sem elas o checkout é recusado (nunca aprova pagamento sozinho).
PAYMENT_MODE=test
# Credenciais do provedor real (ex.: Mercado Pago, Pagar.me, Asaas) — necessárias apenas em PAYMENT_MODE=live
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# E-mail (SMTP). Sem SMTP_URL os e-mails ficam apenas na tabela "emails" (outbox) e no log.
SMTP_URL=
MAIL_FROM=Agitaê <nao-responda@agitae.com.br>

# Carrega dados fictícios de demonstração se o banco estiver vazio (ignorado em produção)
SEED_DEMO=1
